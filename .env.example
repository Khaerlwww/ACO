# =========================================================================
# aco-nft — konfigurasi khusus Ethereum Mainnet
# =========================================================================
# Skrip ini DIPAKU ke chainId = 1. Tidak akan berjalan di L2 atau testnet.
# =========================================================================

# --- Jaringan -----------------------------------------------------------
# RPC endpoint Ethereum Mainnet. Pilihan:
#   1. Penyedia umum:   https://eth-mainnet.g.alchemy.com/v2/<KEY>
#                       https://mainnet.infura.io/v3/<KEY>
#   2. Flashbots Protect (anti MEV/sandwich; tx tidak lewat mempool publik):
#                       https://rpc.flashbots.net
#                       https://rpc.flashbots.net/fast
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Set ke true kalau RPC_URL di atas adalah Flashbots Protect.
# Hanya untuk label di output; tidak mengubah perilaku skrip.
USING_FLASHBOTS_PROTECT=false

# --- Dompet -------------------------------------------------------------
# WAJIB BURNER. Jangan sekali-kali pakai dompet utama.
PRIVATE_KEY=0xabc...

# --- Target NFT ---------------------------------------------------------
# Boleh alamat 0x... atau nama ENS (mis. azuki.eth) — diresolusi di mainnet.
NFT_CONTRACT=0x0000000000000000000000000000000000000000

# Tanda tangan fungsi mint. Contoh umum di Ethereum:
#   mint(uint256)
#   publicMint(uint256)
#   mint(address,uint256)
#   claim(address,uint256,uint256,address,uint256,(bytes32[],uint256,uint256,address),bytes)
MINT_FN=mint(uint256)

# Argumen, dipisah koma. {WALLET} otomatis diganti dengan alamat burner.
#   mint(uint256)            -> MINT_ARGS=1
#   mint(address,uint256)    -> MINT_ARGS={WALLET},1
MINT_ARGS=1

# Harga per token dalam ETH (msg.value = QUANTITY * MINT_PRICE_ETH).
MINT_PRICE_ETH=0
QUANTITY=1

# --- Strategi biaya (default disesuaikan untuk realitas mainnet) --------
# Batas atas keras. Skrip menolak kirim kalau estimasi melebihi nilai ini.
# Default agak konservatif: cukup untuk era post-Fusaka (gas ~0.1 gwei)
# maupun jika gas sempat naik. Naikkan kalau Anda mint saat kondisi
# kongesti tinggi (mis. NFT hype mint).
MAX_FEE_GWEI=20
MAX_PRIORITY_GWEI=1
MAX_TOTAL_COST_ETH=0.05

# Estimasi tip via eth_feeHistory: ambil persentil TIP_PERCENTILE
# dari N=FEE_HISTORY_BLOCKS blok terakhir.
FEE_HISTORY_BLOCKS=20
TIP_PERCENTILE=50

# --- Fallback estimasi biaya -------------------------------------------
# Rantai fallback: eth_feeHistory -> Chainlink Fast Gas -> getFeeData
# Set ke false untuk melewati Chainlink (langsung ke getFeeData).
USE_CHAINLINK_FALLBACK=true

# Alamat feed Chainlink Fast Gas / Gwei di Ethereum Mainnet.
# Default ini pernah aktif; skrip akan mendeteksi stale / decommissioned
# secara otomatis dan jatuh ke fallback berikutnya. Override jika
# Chainlink merilis feed pengganti di alamat lain.
CHAINLINK_FAST_GAS_FEED=0x169E633A2D1E6c10dD91238Ba11c4A708dfEF37C

# --- Hardening (gerbang ekstra di luar --send) -------------------------
# Wajib `yes` untuk bisa broadcast. Tanpa ini, `--send` akan ditolak walau
# user sudah confirm y/N. Lapisan ekstra mencegah eksekusi tidak sengaja.
LIVE_MINT_APPROVED=no

# Tolak MINT_FN yang nama fungsinya berbahaya (approve, transfer, burn,
# withdraw, dll). Default false; set true HANYA jika Anda paham risikonya.
ALLOW_DANGEROUS_FN=false

# --- Konfirmasi & retry -------------------------------------------------
# Jumlah konfirmasi sebelum dianggap final. Untuk mainnet pasca-Merge,
# 1 biasanya cukup; naikkan ke 2-3 kalau peduli reorg edge case.
CONFIRMATIONS=1

# Retry hanya untuk error transien (nonce, blockhash, RPC 5xx, rate limit).
# Tidak pernah retry pada revert kontrak.
MAX_RETRIES=3
RETRY_DELAY_MS=1500

# =========================================================================
# SNIPER MODE (npm run sniper)
# =========================================================================
# Mode instant execution: tanpa simulasi, tanpa prompt, broadcast secepat mungkin.
# LIVE_MINT_APPROVED & ALLOW_DANGEROUS_FN dari atas TIDAK dipakai di sniper.
# =========================================================================

# Trigger detection mode:
#   immediate  - fire langsung saat skrip dijalankan
#   poll       - poll view function, fire saat return value cocok TRIGGER_EXPECT
#   timestamp  - tunggu sampai TRIGGER_TIMESTAMP (Unix detik), lalu fire
#   block      - tunggu sampai blockNumber >= TRIGGER_BLOCK, lalu fire
TRIGGER_MODE=immediate

# Untuk TRIGGER_MODE=poll
# Signature view function (tanpa argumen, return single value yang bisa dibandingkan).
# Contoh: mintActive() returns (bool), saleState() returns (uint256)
TRIGGER_FN=mintActive() returns (bool)
TRIGGER_EXPECT=true
POLL_MS=200

# Untuk TRIGGER_MODE=timestamp (Unix epoch detik). Set 0 untuk skip.
TRIGGER_TIMESTAMP=0

# Untuk TRIGGER_MODE=block. Set 0 untuk skip.
TRIGGER_BLOCK=0

# RPC tambahan untuk parallel broadcast (comma-separated). Tx akan dikirim
# ke RPC_URL utama + semua URL di sini secara paralel; siapa duluan accept,
# itu yang dipakai. Pakai banyak provider berbeda untuk maksimum inclusion.
# Contoh: https://rpc.ankr.com/eth,https://eth.llamarpc.com
EXTRA_RPC_URLS=

# Gas limit statik (skip estimateGas, hemat ~50-100ms). Set sesuai kebutuhan
# kontrak target. 300_000 cukup untuk mayoritas mint sederhana.
STATIC_GAS_LIMIT=300000

# Priority fee (tip) untuk inclusion cepat. Default 3 gwei lumayan agresif
# untuk era post-Fusaka. Naikkan kalau mint window kongesti tinggi.
SNIPER_PRIORITY_GWEI=3

# Bypass MAX_FEE_GWEI cap di sniper mode? Default false (cap tetap ditegakkan).
# Set true HANYA kalau Anda paham risikonya — bisa menguras saldo wallet kalau
# RPC kasih baseFee yang absurd.
SNIPER_BYPASS_FEE_CAP=false

# Tunggu konfirmasi blok setelah broadcast?
#   false = fire-and-forget (lebih cepat, langsung exit setelah RPC accept)
#   true  = tunggu 1 konfirmasi (kepastian, tapi tidak menambah inclusion rate)
WAIT_FOR_CONFIRMATION=false

# === HOT PATH OPTIMIZATION ===
# Pre-sign tx di pre-flight untuk cut ~50-100ms dari hot path.
# Saat trigger fire, bot tidak perlu fetch nonce/baseFee atau sign — tinggal
# broadcast tx yang sudah di-cache.
#
# Trade-off:
#   - Nonce di-FREEZE saat pre-flight. Pastikan tidak ada tx lain dari wallet
#     ini antara pre-flight dan trigger fire (alasan kenapa burner wallet wajib).
#   - Gas pakai multiplier headroom besar agar survive gas spike sampai mint live.
PRESIGN_TX=false

# Multiplier baseFee untuk pre-signed maxFee (default 5x).
# 1.125^14 ≈ 5, jadi 5x bisa survive 14 blok kongesti penuh dari preflight ke fire.
# maxFee tetap di-cap MAX_FEE_GWEI (kecuali SNIPER_BYPASS_FEE_CAP=true).
PRESIGN_FEE_MULTIPLIER=5
