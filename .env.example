# =========================================================================
# ACO Sniper — konfigurasi instant mint execution
# Khusus Ethereum Mainnet (chainId = 1). Tidak akan jalan di L2/testnet.
# =========================================================================

# --- Jaringan & dompet --------------------------------------------------
# RPC primary. Pilihan:
#   - Penyedia umum:    https://eth-mainnet.g.alchemy.com/v2/<KEY>
#                       https://mainnet.infura.io/v3/<KEY>
#   - Flashbots Protect (anti MEV/sandwich; tx tidak lewat mempool publik):
#                       https://rpc.flashbots.net
#                       https://rpc.flashbots.net/fast
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# WAJIB BURNER. Jangan sekali-kali pakai dompet utama.
PRIVATE_KEY=0xabc...

# --- Target NFT ---------------------------------------------------------
# Boleh alamat 0x... atau nama ENS (mis. azuki.eth).
NFT_CONTRACT=0x0000000000000000000000000000000000000000

# Tanda tangan fungsi mint. Contoh:
#   mint(uint256)
#   mint(address,uint256)         (pakai MINT_ARGS={WALLET},1)
#   publicMint(uint256)
#   claim(address,uint256,uint256,address,uint256,(bytes32[],uint256,uint256,address),bytes)
MINT_FN=mint(uint256)

# Argumen, dipisah koma. {WALLET} otomatis diganti alamat burner.
MINT_ARGS=1

# Harga per token dalam ETH (msg.value = QUANTITY * MINT_PRICE_ETH).
MINT_PRICE_ETH=0
QUANTITY=1

# Izinkan MINT_FN yang berpotensi berbahaya (approve, setApprovalForAll,
# transfer, burn, dst.). Default false; biarkan false kecuali Anda paham resiko.
ALLOW_DANGEROUS_FN=false

# --- Trigger detection --------------------------------------------------
# Mode:
#   immediate  - fire langsung saat skrip dijalankan
#   poll       - poll view function, fire saat return value cocok TRIGGER_EXPECT
#   timestamp  - tunggu sampai TRIGGER_TIMESTAMP (Unix detik), lalu fire
#   block      - tunggu sampai blockNumber >= TRIGGER_BLOCK, lalu fire
TRIGGER_MODE=immediate

# Untuk TRIGGER_MODE=poll. View fn tanpa argumen, return single comparable value.
# Contoh: mintActive() returns (bool), saleState() returns (uint256)
TRIGGER_FN=mintActive() returns (bool)
TRIGGER_EXPECT=true
POLL_MS=200

# Untuk TRIGGER_MODE=timestamp (Unix epoch detik). 0 = tidak dipakai.
TRIGGER_TIMESTAMP=0

# Untuk TRIGGER_MODE=block. 0 = tidak dipakai.
TRIGGER_BLOCK=0

# --- Multi-RPC parallel broadcast ---------------------------------------
# RPC tambahan (comma-separated). Tx dikirim ke RPC_URL utama + semua URL
# di sini secara paralel; Promise.any race untuk first-success.
# Contoh: https://rpc.ankr.com/eth,https://eth.llamarpc.com
EXTRA_RPC_URLS=

# --- Strategi gas -------------------------------------------------------
# Gas limit statik (skip estimateGas, hemat ~50-100ms).
# 300_000 cukup untuk mayoritas mint sederhana.
STATIC_GAS_LIMIT=300000

# Batas atas maxFeePerGas (gwei). Default 20 cukup untuk era post-Fusaka.
# Naikkan kalau mint window kongesti tinggi.
MAX_FEE_GWEI=20

# Priority fee (tip) dalam gwei. Default 3 lumayan agresif.
SNIPER_PRIORITY_GWEI=3

# Bypass MAX_FEE_GWEI cap (HATI-HATI: bisa drain wallet kalau RPC kasih
# baseFee absurd). Default false.
SNIPER_BYPASS_FEE_CAP=false

# --- Pre-signed tx (hot path optimization) ------------------------------
# Pre-sign tx di pre-flight untuk cut ~50-100ms dari hot path.
# Trade-off: nonce di-FREEZE — pastikan tidak ada tx lain dari wallet
# antara pre-flight dan trigger fire.
PRESIGN_TX=false

# Multiplier baseFee untuk pre-signed maxFee (default 5x).
# 1.125^14 ≈ 5, jadi 5x bisa survive 14 blok kongesti penuh.
# maxFee tetap di-cap MAX_FEE_GWEI (kecuali SNIPER_BYPASS_FEE_CAP=true).
PRESIGN_FEE_MULTIPLIER=5
