# =========================================================================
# aco-nft — konfigurasi khusus Ethereum Mainnet
# =========================================================================
# Skrip ini DIPAKU ke chainId = 1. Tidak akan berjalan di L2 atau testnet.
# =========================================================================

# --- Jaringan -----------------------------------------------------------
# RPC endpoint Ethereum Mainnet. Pilihan:
#   1. Penyedia umum:   https://eth-mainnet.g.alchemy.com/v2/<KEY>
#                       https://mainnet.infura.io/v3/<KEY>
#   2. Flashbots Protect (anti MEV/sandwich; tx tidak lewat mempool publik):
#                       https://rpc.flashbots.net
#                       https://rpc.flashbots.net/fast
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Set ke true kalau RPC_URL di atas adalah Flashbots Protect.
# Hanya untuk label di output; tidak mengubah perilaku skrip.
USING_FLASHBOTS_PROTECT=false

# --- Dompet -------------------------------------------------------------
# WAJIB BURNER. Jangan sekali-kali pakai dompet utama.
PRIVATE_KEY=0xabc...

# --- Target NFT ---------------------------------------------------------
# Boleh alamat 0x... atau nama ENS (mis. azuki.eth) — diresolusi di mainnet.
NFT_CONTRACT=0x0000000000000000000000000000000000000000

# Tanda tangan fungsi mint. Contoh umum di Ethereum:
#   mint(uint256)
#   publicMint(uint256)
#   mint(address,uint256)
#   claim(address,uint256,uint256,address,uint256,(bytes32[],uint256,uint256,address),bytes)
MINT_FN=mint(uint256)

# Argumen, dipisah koma. {WALLET} otomatis diganti dengan alamat burner.
#   mint(uint256)            -> MINT_ARGS=1
#   mint(address,uint256)    -> MINT_ARGS={WALLET},1
MINT_ARGS=1

# Harga per token dalam ETH (msg.value = QUANTITY * MINT_PRICE_ETH).
MINT_PRICE_ETH=0
QUANTITY=1

# --- Strategi biaya (default disesuaikan untuk realitas mainnet) --------
# Batas atas keras. Skrip menolak kirim kalau estimasi melebihi nilai ini.
# Default agak konservatif: cukup untuk era post-Fusaka (gas ~0.1 gwei)
# maupun jika gas sempat naik. Naikkan kalau Anda mint saat kondisi
# kongesti tinggi (mis. NFT hype mint).
MAX_FEE_GWEI=20
MAX_PRIORITY_GWEI=1
MAX_TOTAL_COST_ETH=0.05

# Estimasi tip via eth_feeHistory: ambil persentil TIP_PERCENTILE
# dari N=FEE_HISTORY_BLOCKS blok terakhir.
FEE_HISTORY_BLOCKS=20
TIP_PERCENTILE=50

# --- Fallback estimasi biaya -------------------------------------------
# Rantai fallback: eth_feeHistory -> Chainlink Fast Gas -> getFeeData
# Set ke false untuk melewati Chainlink (langsung ke getFeeData).
USE_CHAINLINK_FALLBACK=true

# Alamat feed Chainlink Fast Gas / Gwei di Ethereum Mainnet.
# Default ini pernah aktif; skrip akan mendeteksi stale / decommissioned
# secara otomatis dan jatuh ke fallback berikutnya. Override jika
# Chainlink merilis feed pengganti di alamat lain.
CHAINLINK_FAST_GAS_FEED=0x169E633A2D1E6c10dD91238Ba11c4A708dfEF37C

# --- Konfirmasi & retry -------------------------------------------------
# Jumlah konfirmasi sebelum dianggap final. Untuk mainnet pasca-Merge,
# 1 biasanya cukup; naikkan ke 2-3 kalau peduli reorg edge case.
CONFIRMATIONS=1

# Retry hanya untuk error transien (nonce, blockhash, RPC 5xx, rate limit).
# Tidak pernah retry pada revert kontrak.
MAX_RETRIES=3
RETRY_DELAY_MS=1500
